{
  "expo": {
    "name": "No Excuses",
    "slug": "no-excuses",
    "scheme": "noexcuses",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router"],
