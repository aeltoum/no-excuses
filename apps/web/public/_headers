# Vite fingerprints built files, so they never change at a given URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800

# Invite links carry a token in the path; never send it on in a Referer.
/*
  Referrer-Policy: no-referrer
