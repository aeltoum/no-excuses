// The API on Cloudflare Workers Free. Secrets live in Cloudflare (dashboard or
// `wrangler secret put`), never here: DATABASE_URL, SUPABASE_URL,
// SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, INVITATION_SECRET, PWA_ORIGIN,
// VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "no-excuses-api",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-10-01",
  // node:crypto, node:async_hooks, Buffer, pg sockets, and process.env from secrets.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Keep values set in the dashboard when a deploy runs.
  "keep_vars": true,
  // Run next to Supabase (AWS us-east-1): each request makes several database and Auth round
  // trips, so running near the member instead made them cross the ocean one by one.
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
  // Pooled database connections near Supabase (Workers Free, caching off so reads stay fresh).
  // cloudflare.ts uses it in place of DATABASE_URL. `wrangler dev` uses localConnectionString.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "657acc2fe26544bfba97129fe974390f",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
    }
  ],
  // Weekly rollover, cleanup, and push delivery, as the Node process did every minute.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
