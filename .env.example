# Local-only public client configuration.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# Browser-readable PWA configuration. Never use service-role or database credentials here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_API_BASE_URL=http://127.0.0.1:8787

# Server-only. Set actual values in ignored .env.local; never prefix with VITE_ or EXPO_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# Add server-only SUPABASE_SERVICE_ROLE_KEY from local Supabase status manually.
INVITATION_SECRET=replace-me
PWA_ORIGIN=http://127.0.0.1:4174
PORT=8787
HOST=127.0.0.1
# Private one-time operator seed; remove after use.
SEED_ORGANIZER_EMAIL=replace-with-first-organizer-email
